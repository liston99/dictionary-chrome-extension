{
    "manifest_version": 3,
    "name": "My Dictionary",
    "version": "1.1.3",
    "description": "A Dictionary App",
    "action":{
        "default_popup": "index.html"
    },
    "icons":{
        "16": "icon-16.png",
        "32": "icon-32.png",
        "128": "icon-128.png"
    },
    "content_scripts":[
        {
            "matches": ["<all_urls>"],
            "js": ["src/content.jsx"],
            "run_at": "document_idle"
        }
    ]
}